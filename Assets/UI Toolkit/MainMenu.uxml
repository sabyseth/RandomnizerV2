    <ui:VisualElement name="Container" style="flex-grow: 1; top: 0;">
        <ui:Button text="Start" parse-escape-sequences="true" display-tooltip-when-elided="true" name="StartGameButton" class="button" style="border-top-left-radius: 10px; border-top-right-radius: 10px; border-bottom-right-radius: 10px; border-bottom-left-radius: 10px; background-color: rgba(255, 255, 255, 0); background-image: url(&quot;project://database/Assets/Buttons/PNG/12Button_Long_Blue.png?fileID=2800000&amp;guid=4e75355f0aa718a498d932c89b2b994c&amp;type=3#12Button_Long_Blue&quot;); height: 150px; width: 450px;" />
