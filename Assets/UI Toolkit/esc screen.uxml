<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" xsi="http://www.w3.org/2001/XMLSchema-instance" engine="UnityEngine.UIElements" editor="UnityEditor.UIElements" noNamespaceSchemaLocation="../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="project://database/Assets/MainMenuStyle.uss?fileID=7433441132597879392&amp;guid=5634a699ad06e444eb2f7f406d999e11&amp;type=3#MainMenuStyle" />
    <ui:VisualElement name="EscMenu" style="flex-grow: 1; top: 0;">
        <ui:Button text="Resume" parse-escape-sequences="true" display-tooltip-when-elided="true" name="ResumeButton" class="button" style="border-top-left-radius: 10px; border-top-right-radius: 10px; border-bottom-right-radius: 10px; border-bottom-left-radius: 10px; background-color: rgba(255, 255, 255, 0); background-image: url(&quot;project://database/Assets/Buttons/PNG/19bttn-midl.png?fileID=2800000&amp;guid=aa3bf53c498deb44b80ad60af801942c&amp;type=3#19bttn-midl&quot;); height: 150px; width: 500px; -unity-background-image-tint-color: rgb(207, 203, 203);" />
        <ui:Button text="Settings" parse-escape-sequences="true" display-tooltip-when-elided="true" name="SettingsButton" class="button" style="height: 150px; width: 500px; background-color: rgba(188, 188, 188, 0);" />
        <ui:Button text="Quit" parse-escape-sequences="true" display-tooltip-when-elided="true" name="QuitButton" class="button" style="left: 0; bottom: 0; color: rgb(27, 27, 27); background-color: rgba(188, 188, 188, 0); border-left-color: rgba(56, 56, 56, 0); border-right-color: rgba(56, 56, 56, 0); border-top-color: rgba(56, 56, 56, 0); border-bottom-color: rgba(56, 56, 56, 0);" />
    </ui:VisualElement>
</ui:UXML>
